extends Node2D
@onready var fade: CanvasLayer = $fade

func _ready() -> void:
	DialogueManager.dialogue_finished.connect(_on_dialogue_finished)

	fade.show()
	fade.get_node("ColorRect").color = Color.BLACK
	fade.get_node("ColorRect").color.a = 1.0

	await get_tree().process_frame
	await fade.fade(0.0, 0.5).finished

	start_room_dialogue()
func start_room_dialogue() -> void:
	DialogueManager.queue_dialogue("maria", "what the-")
	DialogueManager.queue_dialogue("maria", "who are you?")
	DialogueManager.queue_dialogue("???", "you took your time.")
	DialogueManager.queue_dialogue("maria", "what?")
	DialogueManager.queue_dialogue("???", "hm. nothing, i didn't expect you to answer.")
	DialogueManager.queue_dialogue("maria", "how did you get in here?")
	DialogueManager.queue_dialogue("???", "i'd imagine the same way you did")
	DialogueManager.queue_dialogue("maria", "but i've never seen you before")
	DialogueManager.queue_dialogue("???", "no you have not.")
	DialogueManager.queue_dialogue("maria", "wow. very helpful.")
	DialogueManager.queue_dialogue("maria", "what even is this place? what are you doing here?")
	DialogueManager.queue_dialogue("???", "you have so many questions...")
	DialogueManager.queue_dialogue("maria", "you're standing in a house in the middle of nowhere in /my/ dream. i think i'd be entitled to a few")
	DialogueManager.queue_dialogue("???", "hm... i suppose that's fair.")
	DialogueManager.queue_dialogue("???", "tell me, maria. when you dream of this house do you ever stop to wonder why you keep coming back?")
	DialogueManager.queue_dialogue("maria", "...")
	DialogueManager.queue_dialogue("maria", "how do you know my name?")
	DialogueManager.queue_dialogue("???", "that's not an answer.")
	DialogueManager.queue_dialogue("maria", "how do you know my name.")
	DialogueManager.queue_dialogue("???", "am i not supposed to?")
	DialogueManager.queue_dialogue("(maria)", "(i should leave.)")
	DialogueManager.queue_dialogue("(maria)", "(I should turn around - get out of this room and never look back)")
	DialogueManager.queue_dialogue("???", "you look tired.")
	DialogueManager.queue_dialogue("maria", "i don't know who you are- /what/ you are.")
	DialogueManager.queue_dialogue("???", "nor do you know what i am not.")
	DialogueManager.queue_dialogue("maria", "that's not an answer.")
	DialogueManager.queue_dialogue("???", "you're right. it's not. but it is true.")
	DialogueManager.queue_dialogue("???", "you have been wandering for a long time now... you must have noticed by now that this place doesn't make much sense.")
	DialogueManager.queue_dialogue("maria", "yeah i guess that's one way of putting it...")
	DialogueManager.queue_dialogue("???", "perhaps a story could help.")
	DialogueManager.queue_dialogue("maria", "a story? seriously? i'm not five.")
	DialogueManager.queue_dialogue("???", "stories are such a useful medium. they let us speak about what we could not bear to name directly.")
	DialogueManager.queue_dialogue("???", "just listen. indulge me.")
	DialogueManager.queue_dialogue("???", "there once was a lone traveller who was lost within a forest.")
	DialogueManager.queue_dialogue("???", "night had fallen long ago, the trees stood so hugged together that the traveller could barely see the sky. every path seemed to lead back to where it began.")
	DialogueManager.queue_dialogue("???", "the traveller was scared, but not foolish. they knew that wandering without thought could only reason to become more lost.")
	DialogueManager.queue_dialogue("???", "so they took a length of string and tied it to a branch.")
	DialogueManager.queue_dialogue("???", "they walked a little way, and then another leaving a trail of string behind them.")
	DialogueManager.queue_dialogue("???", "when the path grew unsteady, they could follow the string back to where they had been.")
	DialogueManager.queue_dialogue("???", "it was the smart thing to do, they thought so at least.")
	DialogueManager.queue_dialogue("???", "but the forest was vast, large, and the string was not endless.")
	DialogueManager.queue_dialogue("???", "soon, the traveller could go no farther, the string pulled tight.")
	DialogueManager.queue_dialogue("???", "searching their bag, the traveller noticed they had also brought matches.")
	DialogueManager.queue_dialogue("???", "striking one, for a moment the forest was revealed; every twisted root, low branch, and pale stone beneath their feet.")
	DialogueManager.queue_dialogue("???", "then the match burned down, darkness returned.")
	DialogueManager.queue_dialogue("???", "they struck another.")
	DialogueManager.queue_dialogue("???", "and another.")
	DialogueManager.queue_dialogue("???", "each flame showed them a little of this large world, but never for long enough.")
	DialogueManager.queue_dialogue("???", "the traveller trembled in fear each moment after the light went out, more than they did in the darkness itself.")
	DialogueManager.queue_dialogue("???", "the fear of losing comfort.")
	DialogueManager.queue_dialogue("???", "and at last, in the bottom of their bag, the traveller found a candle.")
	DialogueManager.queue_dialogue("???", "they lit it.")
	DialogueManager.queue_dialogue("???", "the flame was small, and the forest remained large. it could not reveal every path, neither could it promise the traveller a way home.")
	DialogueManager.queue_dialogue("???", "but it stayed lit. at least long enough to see the next steps.")
	DialogueManager.queue_dialogue("???", "the traveller continued the forest, carrying that small flame with them.")
	DialogueManager.queue_dialogue("???", "not because it showed them the way, but because it allowed for them to keep searching.")
	DialogueManager.queue_dialogue("maria", "that's it?")
	DialogueManager.queue_dialogue("???", "hm? we're you expecting a different ending?")
	DialogueManager.queue_dialogue("maria", "i was expecting a point.")
	DialogueManager.queue_dialogue("???", "even if you may not see it, there is one. though i can not promise you will like it.")
	DialogueManager.queue_dialogue("maria", "and what am i supposed to learn from a childrens story?")
	DialogueManager.queue_dialogue("???", "that there is a difference between finding your way back and seeing a way forward.")
	DialogueManager.queue_dialogue("???", "a trail can lead you to where you have been already. a spark can show you what in front of you, then leave you with nothing at all.")
	DialogueManager.queue_dialogue("???", "sometimes, all you need is enough light to take the next step.")
	DialogueManager.queue_dialogue("maria", "and what if the light leads me somewhere i shouldn't go?")
	DialogueManager.queue_dialogue("???", "then at least you will see where you have gone.")
	DialogueManager.queue_dialogue("maria", "...")
	DialogueManager.queue_dialogue("maria", "why are you telling me this?")
	DialogueManager.queue_dialogue("???", "because you are lost.")
	DialogueManager.queue_dialogue("???", "and because you will have to choose what to carry with you when you leave.")
	DialogueManager.queue_dialogue("???", "you do not need to decide what the story means to me, maria.")
	DialogueManager.queue_dialogue("???", "only what it means to you.")
	DialogueManager.queue_dialogue("???", "so what will you take?
	0.1 the string
	0.2 the match
	0.3 the candle.")
	
func _on_dialogue_finished() -> void:
	get_tree().change_scene_to_file("res://in game scenes/night one/scenes/choices/brchoicemenu.tscn")
