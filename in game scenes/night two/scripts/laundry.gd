extends Node2D
@onready var fade: CanvasLayer = $fade

func _ready() -> void:
	DialogueManager.dialogue_finished.connect(_on_dialogue_finished)

	fade.show()
	fade.get_node("ColorRect").color = Color.BLACK
	fade.get_node("ColorRect").color.a = 1.0

	await get_tree().process_frame
	await fade.fade(0.0, 0.5).finished

	start_room_dialogue()
func start_room_dialogue() -> void:
	DialogueManager.queue_dialogue("maria", "you're here... again.")
	DialogueManager.queue_dialogue("sylvan", "you found me.")
	DialogueManager.queue_dialogue("maria", "i wasn't looking for you.")
	DialogueManager.queue_dialogue("sylvan", "hm. not intentionally.")
	DialogueManager.queue_dialogue("maria", "...")
	DialogueManager.queue_dialogue("maria", "were you waiting for me?")
	DialogueManager.queue_dialogue("sylvan", "does it matter?")
	DialogueManager.queue_dialogue("maria", "i'd like to know if you're going to answer a single one of my questions this time.")
	DialogueManager.queue_dialogue("sylvan", "if you want an answer you must ask a question worth answering.")
	DialogueManager.queue_dialogue("maria", "what are you?")
	DialogueManager.queue_dialogue("sylvan", "...")
	DialogueManager.queue_dialogue("sylvan", "perhaps a question you aren't ready to ask.")
	DialogueManager.queue_dialogue("maria", "that seems convenient.")
	DialogueManager.queue_dialogue("sylvan", "you could say that.")
	DialogueManager.queue_dialogue("maria", "you know my name, you know this place. you keep appearing wherever i go-")
	DialogueManager.queue_dialogue("maria", "and /every/ time i ask you why, you tell me a story.")
	DialogueManager.queue_dialogue("sylvan", "stories are easier to carry than answers.")
	DialogueManager.queue_dialogue("maria", "...")
	DialogueManager.queue_dialogue("sylvan", "tell me, maria.")
	DialogueManager.queue_dialogue("sylvan", "if you were trapped somewhere, what would you bring with you?")
	DialogueManager.queue_dialogue("maria", "... something that would get me out?")
	DialogueManager.queue_dialogue("sylvan", "then perhaps you will understand this one.")
	DialogueManager.queue_dialogue("sylvan", "there once was a woman who lived in a house with a locked room.")
	DialogueManager.queue_dialogue("maria", "and what was in it?")
	DialogueManager.queue_dialogue("sylvan", "she did not know.")
	DialogueManager.queue_dialogue("maria", "then how did she know that it was worth opening?")
	DialogueManager.queue_dialogue("sylvan", "she didn't. but every night, she would hear something move on the other side of the door.")
	DialogueManager.queue_dialogue("sylvan", "the woman tried and tried to understand the room without entering it.")
	DialogueManager.queue_dialogue("sylvan", "she held a mirror under the door, hoping to see what laid beyond...")
	DialogueManager.queue_dialogue("sylvan", "but the room was too dark.")
	DialogueManager.queue_dialogue("sylvan", "the mirror could only show her what the little light allowed.")
	DialogueManager.queue_dialogue("sylvan", "so she found a photograph. it showed the room as it had been many years ago-")
	DialogueManager.queue_dialogue("sylvan", "the furniture, the windows, and a figure standing in the corner.")
	DialogueManager.queue_dialogue("maria", "who was the figure?")
	DialogueManager.queue_dialogue("sylvan", "the photograph could not tell her.")
	DialogueManager.queue_dialogue("maria", "but... she could see it?")
	DialogueManager.queue_dialogue("sylvan", "she could see that something had been there before. not that it remained there.")
	DialogueManager.queue_dialogue("sylvan", "the woman spent many nights studying the photograph. she turned it over, held it to the light, and searched every edge for something she may have missed.")
	DialogueManager.queue_dialogue("sylvan", "the mirror helped her examine the shadows. the photograph helped her remember them.")
	DialogueManager.queue_dialogue("sylvan", "but the room remained locked.")
	DialogueManager.queue_dialogue("maria", "so what did she do?")
	DialogueManager.queue_dialogue("sylvan", "eventually, she stopped trying to see through the door.")
	DialogueManager.queue_dialogue("sylvan", "she found the key.")
	DialogueManager.queue_dialogue("maria", "just like that?")
	DialogueManager.queue_dialogue("sylvan", "well, no. she searched for it. she asked everyone who lived in the house before her.")
	DialogueManager.queue_dialogue("sylvan", "some said the key had been lost, others said the room had never been locked at all.")
	DialogueManager.queue_dialogue("maria", "but she found it anyway?")
	DialogueManager.queue_dialogue("sylvan", "yes. and when she turned the lock the door opened.")
	DialogueManager.queue_dialogue("maria", "what was inside?")
	DialogueManager.queue_dialogue("sylvan", "that is where the story ends.")
	DialogueManager.queue_dialogue("maria", "what? that's not an ending.")
	DialogueManager.queue_dialogue("sylvan", "it is an ending to the part of the story that matters.")
	DialogueManager.queue_dialogue("maria", "so you're telling me she goes through all that trouble, and you won't even tell me what she found?")
	DialogueManager.queue_dialogue("sylvan", "you asked what she needed to leave the room behind. not what she found inside of it.")
	DialogueManager.queue_dialogue("sylvan", "the mirror showed her what she could see.")
	DialogueManager.queue_dialogue("sylvan", "the photograph had preserved what she had seen before.")
	DialogueManager.queue_dialogue("sylvan", "neither could change the door.")
	DialogueManager.queue_dialogue("sylvan", "the key gave her a choice. it did not promise that the room would be empty, safe, or anything that she hoped it would be.")
	DialogueManager.queue_dialogue("maria", "... it just opened the door.")
	DialogueManager.queue_dialogue("sylvan", "sometimes, that is enough.")
	DialogueManager.queue_dialogue("maria", "...")
	DialogueManager.queue_dialogue("maria", "is this supposed to be about me?")
	DialogueManager.queue_dialogue("sylvan", "most things you hear in here will be.")
	DialogueManager.queue_dialogue("maria", "and what if i choose the wrong thing?")
	DialogueManager.queue_dialogue("sylvan", "then you chose wrong.")
	DialogueManager.queue_dialogue("maria", "you make everything sound like it just... doesn't matter.")
	DialogueManager.queue_dialogue("sylvan", "no, maria. i make it sound as though your choices belong to you.")
	DialogueManager.queue_dialogue("maria", "...")
	DialogueManager.queue_dialogue("maria", "what if i don't want to open the door?")
	DialogueManager.queue_dialogue("sylvan", "then you should think about why you came looking for a key.")
	DialogueManager.queue_dialogue("maria", "/i/ didn't come looking for anything. i went to sleep.")
	DialogueManager.queue_dialogue("sylvan", "yet, here you are.")
	DialogueManager.queue_dialogue("sylvan", "you do not need to know what waits behhind every door.")
	DialogueManager.queue_dialogue("sylvan", "but, if you want to leave one, you must decide whether you want to look at it, remember it, or pass through it.")
	DialogueManager.queue_dialogue("sylvan", "so which one will you take?
	0.1 the key
	0.2 the mirror
	0.3 the photograph")
	
func _on_dialogue_finished() -> void:
	get_tree().change_scene_to_file("res://in game scenes/night two/scenes/choices/lychoicemenu.tscn")
